<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-items" author="inboxai">
        <createTable tableName="items">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="source_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_items_source"
                             references="sources(id)"/>
            </column>
            <column name="guid" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(1024)"/>
            <column name="link" type="VARCHAR(2048)"/>
            <column name="content_html" type="TEXT"/>
            <column name="content_text" type="TEXT"/>
            <column name="published_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="fetched_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(32)"/>
            <column name="summary" type="VARCHAR(1024)"/>
            <column name="classified_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="classification_cost_usd" type="NUMERIC(12, 8)"/>
        </createTable>

        <addUniqueConstraint
                tableName="items"
                columnNames="source_id, guid"
                constraintName="uk_items_source_guid"/>

        <createIndex tableName="items" indexName="idx_items_source_published">
            <column name="source_id"/>
            <column name="published_at"/>
        </createIndex>

        <createIndex tableName="items" indexName="idx_items_category">
            <column name="category"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
